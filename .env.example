# OpenWeatherMap: https://home.openweathermap.org/api_keys (free tier)
# Optional: if empty or rate-limited, the app falls back to Open-Meteo (no key needed).
VITE_OPENWEATHER_API_KEY=

# GeoDB Cities via RapidAPI: https://rapidapi.com/wirefreethought/api/geodb-cities (free BASIC plan)
# Optional: if empty or rate-limited, autocomplete falls back to Open-Meteo Geocoding.
VITE_RAPIDAPI_KEY=
VITE_RAPIDAPI_HOST=wft-geo-db.p.rapidapi.com
